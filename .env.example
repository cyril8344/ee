# ============================================================================
# XAU/USD Scalping Bot — variables d'environnement
# Copier en ".env" (même dossier) et remplir. .env est ignoré par git :
# n'y commite JAMAIS de vraie valeur, ni ici ni ailleurs.
#
# Liste établie en lisant le code (os.environ / os.getenv dans backend/),
# le 26/11/2026. Sur Railway ces valeurs sont dans l'onglet Variables ;
# sur la VM Oracle, deploy/oracle/install.sh les récupère et écrit .env.
# Sans aucune clé, le bot tourne sur yfinance puis sur le repli synthétique.
# ============================================================================

# --- Accès au dashboard (auth.py) ---------------------------------------------
# Sans ADMIN_PASSWORD, auth.py accepte "changeme" : à ne jamais laisser ainsi
# sur une machine joignable depuis Internet. Laissées commentées ici exprès :
# une ligne "ADMIN_PASSWORD=" vide ferait accepter un mot de passe vide
# (os.environ.get ne retombe sur le défaut que si la clé est absente).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Secret de signature des jetons de connexion. Absent => tiré au hasard à chaque
# démarrage (tout le monde est déconnecté à chaque redémarrage).
# Générer : openssl rand -hex 32
# Même piège : "AUTH_SECRET=" vide signerait les jetons avec une clé vide.
# NB : le code lit AUTH_SECRET ; une variable JWT_SECRET n'est lue nulle part.
# AUTH_SECRET=

# --- Données de marché (data_provider.py) -------------------------------------
# auto | twelvedata | polygon | alphavantage | yfinance | synthetic
# "auto" essaie, parmi ceux dont la clé est définie :
#   twelvedata -> polygon -> alphavantage -> yfinance -> synthetic
XAU_DATA_PROVIDER=auto
TWELVEDATA_API_KEY=
# Pools séparés pour pretrain / walk-forward (n'entament pas le quota live)
TWELVEDATA_API_KEY_BACKTEST=
TWELVEDATA_API_KEY_BACKTEST_2=
# Délai mini entre deux appels Twelve Data, en secondes (défaut 8.0)
# TWELVEDATA_MIN_INTERVAL=8.0
# TWELVEDATA_MIN_INTERVAL_BACKTEST=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
# XAU_TD_SYMBOL=XAU/USD
# XAU_POLY_SYMBOL=X:XAUUSD
# XAU_YF_SYMBOL=GC=F

# --- Flux complémentaires (tous facultatifs) ----------------------------------
FRED_API_KEY=
FINNHUB_API_KEY=
# Utilisée seulement par les modules désactivés (llm_gate, adaptive_agent)
ANTHROPIC_API_KEY=

# --- Alertes Telegram (facultatif, vide = désactivé) --------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Divers --------------------------------------------------------------------
# DISABLE_AGENT=1
# AGENT_INTERVAL_HOURS=4
# WF_MONITOR_INTERVAL_HOURS=168
# FEATURES_B_PATH=data/features_B.csv

# --- Base de données ----------------------------------------------------------
# Défaut : /data/xau_bot.db si /data existe (Railway, Docker), sinon
# backend/xau_bot.db.
# XAU_DB_PATH=/absolute/path/to/xau_bot.db

# --- VM Oracle uniquement (deploy/oracle/) ------------------------------------
# Écrites par install.sh, inutiles sur Railway et en local.
# DOMAIN=1-2-3-4.sslip.io        # nom du dashboard en HTTPS
# XAU_DATA_DIR=/var/lib/xau-bot  # dossier de la VM monté sur /data
# XAU_BRANCH=main                # branche suivie par la mise à jour auto

# --- Frontend (dev uniquement) ------------------------------------------------
# VITE_API_URL=http://localhost:8000
